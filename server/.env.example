# Backend Environment Variables (server/.env)
NODE_ENV=development
PORT=5000

# Neon PostgreSQL: pooled for runtime, direct for migrations
DATABASE_URL=
DIRECT_URL=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=8h

# CORS Origins
CUSTOMER_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Argon2id Parameters
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Password Reset Email (Nodemailer)
# Leave SMTP_HOST empty in development to use an Ethereal test inbox (preview URL printed to console).
RESET_TOKEN_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VÉLORA" <no-reply@velora.local>

# Frontend Environment Variables (client/customer/.env and client/admin/.env)
# VITE_API_BASE_URL=http://localhost:5000/api
